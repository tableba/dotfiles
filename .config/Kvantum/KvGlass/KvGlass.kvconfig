[%General]
author=Victor Calles / Adjusted for Compact Gruvbox
comment=compact transparent gruvbox theme
x11drag=all
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
embedded_tabs=false
mirror_doc_tabs=false
active_tab_overlap=10
group_toolbar_buttons=true
spread_progressbar=true
composite=true
menu_shadow_depth=7
tooltip_shadow_depth=6
scroll_width=10
scroll_arrows=false
scroll_min_extent=40
transient_scrollbar=true
slider_width=5
slider_handle_width=14
slider_handle_length=14
center_toolbar_handle=true
check_size=14
textless_progressbar=false
progressbar_thickness=30
menubar_mouse_tracking=true
toolbutton_style=0
double_click=false
translucent_windows=true
blurring=true
popup_blurring=true
opaque=kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,smplayer,smplayer2,avidemux,avidemux2_qt4,avidemux3_qt4,avidemux3_qt5,kamoso,QtCreator,VirtualBox,trojita,dragon,digikam
vertical_spin_indicators=false
fill_rubberband=false
merge_menubar_with_toolbar=true
small_icon_size=14
large_icon_size=24
button_icon_size=14
toolbar_icon_size=14
combo_as_lineedit=false
animate_states=true
button_contents_shift=true
combo_menu=false
groupbox_top_label=false
hide_combo_checkboxes=false
inline_spin_indicators=false
joined_inactive_tabs=true
layout_margin=2
layout_spacing=1
no_window_pattern=false
reduce_window_opacity=0
respect_DE=true
scrollable_menu=false
scrollbar_in_view=false
spin_button_width=14
submenu_delay=200
submenu_overlap=0
tooltip_delay=-1
transient_groove=false
tree_branch_line=false

[GeneralColors]
window.color=#282828
base.color=#1d2021
alt.base.color=#282828
button.color=#3c3836
light.color=#504945
mid.light.color=#3c3836
dark.color=#1d2021
mid.color=#32302f
highlight.color=#d79921
inactive.highlight.color=#504945
tooltip.base.color=#1d2021
text.color=#ebdbb2
window.text.color=#ebdbb2
button.text.color=#ebdbb2
disabled.text.color=#928374
tooltip.text.color=#ebdbb2
highlight.text.color=#282828
link.color=#83a598
link.visited.color=#d3869b

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=true
transparent_pcmanfm_sidepane=true
blur_translucent=true
transparent_menutitle=false
respect_darkness=true
kcapacitybar_as_progressbar=true
force_size_grip=true
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=100
lxqtmainmenu_iconsize=0
no_selection_tint=false
normal_default_pushbutton=false
single_top_toolbar=false
tint_on_mouseover=0
transparent_pcmanfm_view=false

[PanelButtonCommand]
frame.element=button
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior.element=button
indicator.size=8
text.normal.color=#ebdbb2
text.focus.color=#ebdbb2
text.press.color=#ebdbb2
text.toggle.color=#ebdbb2
text.shadow=0
text.margin=1
text.iconspacing=2
indicator.element=arrow
text.margin.top=2
text.margin.bottom=2
text.margin.left=2
text.margin.right=2
frame.expansion=8

[PanelButtonTool]
inherits=PanelButtonCommand

[Dock]
inherits=PanelButtonCommand
interior.element=dock
frame.element=dock
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.normal.color=#ebdbb2

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.normal.color=#ebdbb2
text.focus.color=#d79921
text.bold=true

[IndicatorSpinBox]
inherits=PanelButtonCommand
indicator.element=arrow
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
indicator.size=8
text.normal.color=#ebdbb2

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.normal.color=#ebdbb2
text.focus.color=#d79921

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.normal.color=#ebdbb2
text.focus.color=#d79921

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.left=1
text.margin.right=1

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=8

[ToolboxTab]
inherits=PanelButtonCommand
text.normal.color=#ebdbb2
text.press.color=#ebdbb2
text.focus.color=#d79921

[Tab]
inherits=PanelButtonCommand
interior.element=tab
text.margin.left=6
text.margin.right=6
text.margin.top=0
text.margin.bottom=0
text.normal.color=#ebdbb2
frame.element=tab
indicator.element=tab
frame.top=3
frame.bottom=2
frame.left=2
frame.right=2
frame.expanded.top=0
frame.expanded.bottom=0
frame.expanded.left=0
frame.expanded.right=0
text.focus.color=#ebdbb2
text.press.color=#ebdbb2
text.toggle.color=#ebdbb2
frame.expansion=0
indicator.size=6
text.shadow=false

[TabFrame]
inherits=GenericFrame
frame.element=tabcommon
interior=true
interior.element=tframe
frame.top=4
frame.bottom=1
frame.left=1
frame.right=1
interior.x.patternsize=20
interior.y.patternsize=15

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=8
indicator.element=arrow

[HeaderSection]
inherits=PanelButtonCommand
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[SizeGrip]
indicator.element=resize-grip

[Toolbar]
inherits=PanelButtonCommand
indicator.element=toolbar
indicator.size=5
text.margin=0
interior.element=tolba
frame.element=tolba
text.normal.color=#ebdbb2
text.focus.color=#ebdbb2
frame.left=4
frame.right=0
frame.top=0
frame.bottom=0
frame.expansion=0

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
text.margin=0
text.normal.color=#ebdbb2
text.focus.color=#ebdbb2
text.press.color=#ebdbb2
text.toggle.color=#ebdbb2
text.bold=true
frame.expansion=6

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern

[ItemView]
inherits=PanelButtonCommand
text.margin=0
frame.element=itemview
interior.element=itemview
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.margin.top=1
text.margin.bottom=1
text.margin.left=2
text.margin.right=2
text.normal.color=#ebdbb2
text.focus.color=#282828
text.press.color=#ebdbb2
text.toggle.color=#ebdbb2
frame.expansion=4

[Splitter]
indicator.size=24

[Scrollbar]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=8

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior=false
frame.left=4
frame.right=4
frame.top=4
frame.bottom=4
indicator.element=grip
indicator.size=10
frame.expansion=0

[ScrollbarGroove]
inherits=PanelButtonCommand
interior=false
frame=false

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
size.minheight=18
text.normal.color=#ebdbb2
text.focus.color=#ebdbb2
text.margin.top=1
text.margin.bottom=1
text.margin.left=10
text.margin.right=4
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
frame.expansion=0

[MenuBar]
inherits=PanelButtonCommand
frame.element=none
interior.element=none
frame.expansion=0

[MenuBarItem]
inherits=PanelButtonCommand
interior=true
interior.element=menubaritem
frame.element=menubaritem
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.margin.left=3
text.margin.right=3
text.margin.top=0
text.margin.bottom=0
text.normal.color=#ebdbb2
text.focus.color=#ebdbb2
frame.expansion=0

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior.element=titlebar
indicator.size=10
indicator.element=mdi
text.normal.color=#928374
text.focus.color=#ebdbb2
text.bold=true
text.italic=true
frame.expansion=0

[ComboBox]
inherits=PanelButtonCommand
indicator.element=comboarrow
indicator.size=10

[Menu]
inherits=PanelButtonCommand
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
frame.element=menu
interior.element=menu
size.minheight=18
size.minwidth=18
text.normal.color=#ebdbb2
frame.expansion=0

[GroupBox]
inherits=PanelButtonCommand
frame=true
frame.element=common
text.shadow=0
text.margin=0
interior=true
interior.element=common
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.normal.color=#ebdbb2
text.press.color=#ebdbb2
text.focus.color=#d79921
text.bold=true
frame.expansion=0
interior.x.patternsize=20
interior.y.patternsize=15

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false
text.shadow=0

[ToolTip]
inherits=GenericFrame
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=true
text.shadow=0
text.margin=0
interior.element=tooltip
frame.element=tooltip
frame.expansion=0

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=true
interior.element=window
interior.x.patternsize=40
interior.y.patternsize=40
